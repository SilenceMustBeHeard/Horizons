﻿@{
ViewData["Title"] = "Horizons - Modern Travel Stories";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <span class="hero-tag">TRAVEL STORIES</span>
            <h1 class="hero-title">Stories That<br>Inspire Adventure</h1>
            <p class="hero-description">Discover the world's most breathtaking destinations through the eyes of fellow travelers. Get inspired, plan your journey, and share your own stories.</p>
            <div class="hero-buttons">
                <a asp-controller="Destination" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-globe-americas"></i> Explore Destinations
                </a>
              @*   <a asp-controller="Destination" asp-action="Map" class="btn btn-outline">
                    <i class="fas fa-map-marked-alt"></i> View Map
                </a> *@
            </div>
        </div>
        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number" id="heroDestinationsCount">0</span>
                <span class="stat-label">Destinations</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" id="heroCountriesCount">0</span>
                <span class="stat-label">Countries</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" id="heroStoriesCount">0</span>
                <span class="stat-label">Travel Stories</span>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-tag">DISCOVER BY</span>
            <h2 class="section-title">Travel Categories</h2>
            <p class="section-subtitle">Find your next adventure based on your favorite terrain</p>
        </div>

        <div class="categories-grid">
            <div class="category-card" data-category="mountains">
                <div class="category-icon">
                    <i class="fas fa-mountain"></i>
                </div>
                <h3 class="category-title">Mountains</h3>
                <p class="category-count" id="mountainsCount">0 destinations</p>
                <div class="category-overlay"></div>
            </div>

            <div class="category-card" data-category="beaches">
                <div class="category-icon">
                    <i class="fas fa-umbrella-beach"></i>
                </div>
                <h3 class="category-title">Beaches</h3>
                <p class="category-count" id="beachesCount">0 destinations</p>
                <div class="category-overlay"></div>
            </div>

            <div class="category-card" data-category="forests">
                <div class="category-icon">
                    <i class="fas fa-tree"></i>
                </div>
                <h3 class="category-title">Forests</h3>
                <p class="category-count" id="forestsCount">0 destinations</p>
                <div class="category-overlay"></div>
            </div>

            <div class="category-card" data-category="urban">
                <div class="category-icon">
                    <i class="fas fa-city"></i>
                </div>
                <h3 class="category-title">Urban</h3>
                <p class="category-count" id="urbanCount">0 destinations</p>
                <div class="category-overlay"></div>
            </div>

            <div class="category-card" data-category="deserts">
                <div class="category-icon">
                    <i class="fas fa-sun"></i>
                </div>
                <h3 class="category-title">Deserts</h3>
                <p class="category-count" id="desertsCount">0 destinations</p>
                <div class="category-overlay"></div>
            </div>

            <div class="category-card" data-category="lakes">
                <div class="category-icon">
                    <i class="fas fa-water"></i>
                </div>
                <h3 class="category-title">Lakes</h3>
                <p class="category-count" id="lakesCount">0 destinations</p>
                <div class="category-overlay"></div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Destinations Section -->
<section class="featured-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-tag">CURATED FOR YOU</span>
            <h2 class="section-title">Top Destinations</h2>
            <p class="section-subtitle">Most loved destinations by our community</p>
        </div>

        <div id="featured-destinations" class="destinations-grid">
            <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Loading destinations...</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <div class="cta-text">
                <span class="cta-tag">JOIN THE COMMUNITY</span>
                <h2 class="cta-title">Share Your Travel Story</h2>
                <p class="cta-description">Every journey has a story worth telling. Share your adventures, inspire others, and become part of a growing community of travel enthusiasts.</p>
                <div class="cta-buttons">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                        <i class="fas fa-user-plus"></i> Share
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">
                        <i class="fas fa-user-plus"></i> Join
                    </a>
                </div>
            </div>
            <div class="cta-image">
                <div class="image-stack">
                    <div class="stack-item stack-1"></div>
                    <div class="stack-item stack-2"></div>
                    <div class="stack-item stack-3">
                        <i class="fas fa-camera"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Load stats for hero section
        async function loadStats() {
            try {
                const response = await fetch('/api/destinations/map-data');
                const destinations = await response.json();

                const uniqueCountries = [...new Set(destinations.map(d => d.country).filter(c => c))];
                const totalStories = destinations.length;

                animateNumber(document.getElementById('heroDestinationsCount'), 0, totalStories, 1000);
                animateNumber(document.getElementById('heroCountriesCount'), 0, uniqueCountries.length, 1000);
                animateNumber(document.getElementById('heroStoriesCount'), 0, totalStories, 1000);

                // Update category counts (simplified - based on terrain)
                const terrains = {
                    'mountains': destinations.filter(d => (d.terrain || '').toLowerCase().includes('mountain')).length,
                    'beaches': destinations.filter(d => (d.terrain || '').toLowerCase().includes('beach')).length,
                    'forests': destinations.filter(d => (d.terrain || '').toLowerCase().includes('forest')).length,
                    'urban': destinations.filter(d => (d.terrain || '').toLowerCase().includes('urban') || (d.terrain || '').toLowerCase().includes('city')).length,
                    'deserts': destinations.filter(d => (d.terrain || '').toLowerCase().includes('desert')).length,
                    'lakes': destinations.filter(d => (d.terrain || '').toLowerCase().includes('lake')).length
                };

                for (const [key, count] of Object.entries(terrains)) {
                    const element = document.getElementById(`${key}Count`);
                    if (element) element.textContent = `${count} destinations`;
                }
            } catch (error) {
                console.error('Error loading stats:', error);
            }
        }

        function animateNumber(element, start, end, duration) {
            if (!element) return;
            const range = end - start;
            const increment = range / (duration / 16);
            let current = start;
            const timer = setInterval(() => {
                current += increment;
                if (current >= end) {
                    clearInterval(timer);
                    element.textContent = Math.round(end).toLocaleString();
                } else {
                    element.textContent = Math.round(current).toLocaleString();
                }
            }, 16);
        }

        // Category card click handlers
        document.querySelectorAll('.category-card').forEach(card => {
            card.addEventListener('click', () => {
                const category = card.dataset.category;
                window.location.href = `/Destination/Index?terrain=${category}`;
            });
        });

        // Load stats on page load
        document.addEventListener('DOMContentLoaded', loadStats);
    </script>
}