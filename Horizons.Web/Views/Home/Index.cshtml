﻿@using Horizons.Web.ViewModels.Home
@model HomeIndexViewModel

@{
    ViewData["Title"] = "Horizons - Modern Travel Stories";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <span class="hero-tag">TRAVEL STORIES</span>
            <h1 class="hero-title">Stories That<br>Inspire Adventure</h1>
            <p class="hero-description">Discover the world's most breathtaking destinations through the eyes of fellow travelers. Get inspired, plan your journey, and share your own stories.</p>
            <div class="hero-buttons">
                <a asp-controller="Destination" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-globe-americas"></i> Explore Destinations
                </a>
            </div>
        </div>
        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number">@Model.TotalDestinations</span>
                <span class="stat-label">Destinations</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">@Model.TotalCountries</span>
                <span class="stat-label">Countries</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">@Model.TotalStories</span>
                <span class="stat-label">Travel Stories</span>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-tag">DISCOVER BY</span>
            <h2 class="section-title">Travel Categories</h2>
            <p class="section-subtitle">Find your next adventure based on your favorite terrain</p>
        </div>

        <div class="categories-grid">
            <div class="category-card" data-category="mountains">
                <div class="category-icon">
                    <i class="fas fa-mountain"></i>
                </div>
                <h3 class="category-title">Mountains</h3>
                <p class="category-count">@Model.MountainsCount destinations</p>
            </div>

            <div class="category-card" data-category="beaches">
                <div class="category-icon">
                    <i class="fas fa-umbrella-beach"></i>
                </div>
                <h3 class="category-title">Beaches</h3>
                <p class="category-count">@Model.BeachesCount destinations</p>
            </div>

            <div class="category-card" data-category="forests">
                <div class="category-icon">
                    <i class="fas fa-tree"></i>
                </div>
                <h3 class="category-title">Forests</h3>
                <p class="category-count">@Model.ForestsCount destinations</p>
            </div>

            <div class="category-card" data-category="urban">
                <div class="category-icon">
                    <i class="fas fa-city"></i>
                </div>
                <h3 class="category-title">Urban</h3>
                <p class="category-count">@Model.UrbanCount destinations</p>
            </div>

            <div class="category-card" data-category="deserts">
                <div class="category-icon">
                    <i class="fas fa-sun"></i>
                </div>
                <h3 class="category-title">Deserts</h3>
                <p class="category-count">@Model.DesertsCount destinations</p>
            </div>

            <div class="category-card" data-category="lakes">
                <div class="category-icon">
                    <i class="fas fa-water"></i>
                </div>
                <h3 class="category-title">Lakes</h3>
                <p class="category-count">@Model.LakesCount destinations</p>
            </div>
        </div>
    </div>
</section>
<!-- Featured Destinations Section -->
<section class="featured-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-tag">CURATED FOR YOU</span>
            <h2 class="section-title">Top Destinations</h2>
            <p class="section-subtitle">Most loved destinations by our community</p>
        </div>

        @{
            // Determine how many to show based on authentication
            int maxToShow = User.Identity.IsAuthenticated ? 6 : 3;
            var featuredToShow = Model.FeaturedDestinations.Take(maxToShow);
        }

        @if (featuredToShow.Any())
        {
            <div class="destinations-grid">
                @foreach (var dest in featuredToShow)
                {
                    <div class="destination-card">
                        <div class="destination-image">
                            <img src="@(string.IsNullOrEmpty(dest.ImageUrl) ? "/images/default-image.jpg" : dest.ImageUrl)"
                                 alt="@dest.Name"
                                 loading="lazy"
                                 onerror="this.src='/images/default-image.jpg'">
                            <span class="destination-badge">
                                <i class="fas fa-heart"></i> @dest.Likes
                            </span>
                        </div>
                        <div class="destination-content">
                            <div class="destination-location">
                                <i class="fas fa-map-marker-alt"></i> @(string.IsNullOrEmpty(dest.Country) ? "Unknown" : dest.Country)
                            </div>
                            <h3 class="destination-title">@dest.Name</h3>
                            <p class="destination-description">
                                @(string.IsNullOrEmpty(dest.Description) ? "No description available" : dest.Description)
                            </p>
                            <div class="destination-meta">
                                <span><i class="fas fa-calendar"></i> @dest.CreatedAt.ToString("MMM dd, yyyy")</span>
                                <a href="/Destination/Details/@dest.Id" class="btn-link">
                                    Read Story <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!User.Identity.IsAuthenticated && Model.FeaturedDestinations.Count() > 3)
            {
                <div class="view-all-container text-center mt-5">
                    <div class="d-flex flex-column align-items-center gap-3">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100" style="max-width: 280px;">
                            <i class="fas fa-sign-in-alt"></i> Sign in to share yours
                        </a>
                        <a asp-controller="Destination" asp-action="Index" 
                        class="btn btn-primary btn-sm">
                            <i class="fas fa-globe"></i> See all destinations →
                        </a>
                    </div>
                    <p class="text-muted mt-3 small">
                        <i class="fas fa-heart" style="color: var(--accent-primary);"></i>
                        Join our community of travelers
                    </p>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-compass"></i>
                <p>No destinations yet. Be the first to share your journey!</p>
                <a asp-controller="Destination" asp-action="Add" class="btn btn-primary">Share Your Story</a>
            </div>
        }
    </div>
</section>
<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <div class="cta-text">
                <span class="cta-tag">JOIN THE COMMUNITY</span>
                <h2 class="cta-title">Share Your Travel Story</h2>
                <p class="cta-description">Every journey has a story worth telling. Share your adventures, inspire others, and become part of a growing community of travel enthusiasts.</p>
                <div class="cta-buttons">
                    <a asp-controller="Destination" asp-action="Add" class="btn btn-primary">
                        <i class="fas fa-plus-circle"></i> Share Your Story
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline">
                        <i class="fas fa-user-plus"></i> Join for Free
                    </a>
                </div>
            </div>
            <div class="cta-image">
                <div class="image-stack">
                    <div class="stack-item stack-1"></div>
                    <div class="stack-item stack-2"></div>
                    <div class="stack-item stack-3">
                        <i class="fas fa-camera"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script>
        // Category card click handlers - redirect to destination index with terrain filter
        document.querySelectorAll('.category-card').forEach(card => {
            card.addEventListener('click', () => {
                const category = card.dataset.category;
                window.location.href = `/Destination/Index?terrain=${category}`;
            });
        });
    </script>
}