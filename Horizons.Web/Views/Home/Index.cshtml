@{
    ViewData["Title"] = "Horizons - Adventure Awaits";
}

<div class="welcome-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="hero-badge mb-3">
                    <i class="fas fa-bolt"></i> SINCE 2026 <i class="fas fa-bolt"></i>
                </div>
                <h1 class="display-4">WELCOME TO<br>HORIZONS</h1>
                <p class="lead">Discover the world's most breathtaking destinations and start your adventure today!</p>
                <div class="mt-4">
                    <a href="/Identity/Account/Register" class="btn btn-primary btn-lg mx-2">
                        <i class="fas fa-rocket"></i> START YOUR ADVENTURE
                    </a>
                    <a asp-controller="Destination" asp-action="Map" class="btn btn-outline-primary btn-lg mx-2">
                        <i class="fas fa-map-marked-alt"></i> EXPLORE THE MAP
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="explore-section">
    <div class="container">
        <h2 class="section-title">⚡ EXPLORE THE WORLD ⚡</h2>
        <p class="text-center text-muted mb-5">Discover amazing destinations across different terrains and continents</p>

        <div class="row g-4">
            <!-- Mountain -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-card text-center p-4">
                    <i class="fas fa-mountain" style="font-size: 3rem; color: var(--sport-primary);"></i>
                    <h3 class="mt-3 mb-0">Mountains</h3>
                    <p class="text-muted">Conquer the highest peaks</p>
                </div>
            </div>
            <!-- Beach -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-card text-center p-4">
                    <i class="fas fa-umbrella-beach" style="font-size: 3rem; color: var(--sport-primary);"></i>
                    <h3 class="mt-3 mb-0">Beaches</h3>
                    <p class="text-muted">Paradise coastlines</p>
                </div>
            </div>
            <!-- Forest -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-card text-center p-4">
                    <i class="fas fa-tree" style="font-size: 3rem; color: var(--sport-primary);"></i>
                    <h3 class="mt-3 mb-0">Forests</h3>
                    <p class="text-muted">Ancient woodlands</p>
                </div>
            </div>
            <!-- Urban -->
            <div class="col-lg-3 col-md-6">
                <div class="stat-card text-center p-4">
                    <i class="fas fa-city" style="font-size: 3rem; color: var(--sport-primary);"></i>
                    <h3 class="mt-3 mb-0">Urban</h3>
                    <p class="text-muted">Vibrant city life</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Destinations Section -->
<div class="featured-section py-5">
    <div class="container">
        <h2 class="section-title text-center mb-5">🏆 TOP DESTINATIONS 🏆</h2>
        <div class="row g-4" id="featured-destinations">
            <div class="col-12 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="cta-section py-5 my-4">
    <div class="container text-center">
        <div class="cta-content p-5 rounded-4" style="background: linear-gradient(135deg, rgba(255,51,102,0.1), rgba(0,212,255,0.05)); border: 1px solid var(--sport-primary);">
            <h2 class="mb-3">Ready for Your Next Adventure?</h2>
            <p class="lead mb-4">Join our community of explorers and share your journey with the world.</p>
            <a asp-controller="Destination" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="fas fa-globe"></i> EXPLORE ALL DESTINATIONS
            </a>
        </div>
    </div>
</div>


