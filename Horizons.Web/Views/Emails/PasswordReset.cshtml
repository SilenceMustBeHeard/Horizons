@model Horizons.Data.Models.Base.AppUser

@{
    var resetLink = ViewData["ResetLink"] as string ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password - Horizons</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
            /* Styles are defined in the external CSS file */
            .reset-email-container {
                max-width: 550px;
                margin: 0 auto;
            }
    </style>
</head>
<body style="margin: 0; padding: 0; font-family: 'Inter', 'Segoe UI', Arial, sans-serif; background: linear-gradient(135deg, #0a0f1c 0%, #1a1a2e 100%); padding: 40px 20px;">
    <div class="reset-email-container" style="max-width: 550px; margin: 0 auto; background: rgba(26, 35, 53, 0.95); border-radius: 24px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 51, 102, 0.3);">
        <!-- Header -->
        <div style="background: linear-gradient(135deg, #FF3366 0%, #FF6B35 50%, #00D4FF 100%); padding: 30px; text-align: center;">
            <div style="font-size: 48px; margin-bottom: 15px;">
                ⛰️ ⚡
            </div>
            <h2 style="font-family: 'Orbitron', 'Inter', monospace; font-size: 24px; font-weight: 800; letter-spacing: 3px; color: white; margin: 0; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">HORIZONS</h2>
            <div style="font-size: 12px; color: rgba(255,255,255,0.8); margin-top: 8px; letter-spacing: 1px;">ADVENTURE AWAITS</div>
        </div>

        <!-- Content -->
        <div style="padding: 35px; color: #e0e0e0;">
            <div style="font-size: 18px; font-weight: 600; margin-bottom: 20px; color: white;">
                Hello, <span style="background: linear-gradient(135deg, #FF3366, #FF6B35); -webkit-background-clip: text; background-clip: text; color: transparent;">@Model.FirstName @Model.LastName</span>!
            </div>

            <p style="font-size: 14px; line-height: 1.6; margin-bottom: 20px; color: #b0b8d0;">
                We received a request to reset your password for your Horizons adventure account.
                Don't worry — it happens to the best explorers!
            </p>

            <div style="background: rgba(0, 212, 255, 0.1); border-left: 3px solid #00D4FF; padding: 15px; border-radius: 8px; margin: 25px 0; font-size: 13px;">
                <i class="fas fa-shield-alt" style="color: #00D4FF; margin-right: 10px;"></i>
                Click the button below to create a new password and continue your journey.
            </div>

            <!-- Button -->
            <div style="text-align: center; margin: 30px 0;">
                <a href="@resetLink" style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 32px; background: linear-gradient(135deg, #FF3366, #FF6B35); color: white; text-decoration: none; border-radius: 50px; font-weight: bold; font-size: 14px; letter-spacing: 1.5px; transition: all 0.3s ease;">
                    <span>🏔️</span> RESET PASSWORD <span>⚡</span>
                </a>
            </div>

            <!-- Fallback Link -->
            <div style="background: rgba(0, 0, 0, 0.3); border-radius: 12px; padding: 15px; margin: 20px 0; word-break: break-all;">
                <p style="font-size: 12px; color: #a0a8c0; margin-bottom: 8px;">🔗 If the button doesn't work, copy and paste this link:</p>
                <a href="@resetLink" style="color: #00D4FF; text-decoration: none; font-size: 12px;">@resetLink</a>
            </div>

            <div style="width: 50px; height: 2px; background: linear-gradient(90deg, #FF3366, #00D4FF); margin: 20px auto; border-radius: 2px;"></div>

            <div style="font-size: 12px; color: #a0a8c0; margin-top: 20px; padding-top: 15px; border-top: 1px solid rgba(255, 255, 255, 0.1);">
                <i class="fas fa-clock" style="color: #FF3366; margin-right: 5px;"></i> This reset link will expire in 24 hours for security reasons.
            </div>

            <div style="font-size: 12px; color: #a0a8c0; margin-top: 15px;">
                <i class="fas fa-shield-alt" style="color: #FF3366; margin-right: 5px;"></i> If you didn't request this password reset, please ignore this email. Your account remains secure.
            </div>
        </div>

        <!-- Footer -->
        <div style="text-align: center; padding: 20px; background: rgba(0, 0, 0, 0.3); border-top: 1px solid rgba(255, 255, 255, 0.05);">
            <p style="font-size: 11px; color: #6a7085; margin: 5px 0;">
                <span>🏕️</span> Horizons Adventure Co. <span>⛰️</span>
            </p>
            <p style="font-size: 11px; color: #6a7085; margin: 5px 0;">&copy; @DateTime.Now.Year Horizons. All rights reserved.</p>
            <p style="font-size: 10px; color: #6a7085; margin: 5px 0;">Explore. Conquer. Share.</p>
        </div>
    </div>
</body>
</html>