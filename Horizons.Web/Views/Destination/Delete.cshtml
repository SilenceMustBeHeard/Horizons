@using Horizons.Web.ViewModels.Destination
@model DestinationDeleteViewModel

@{
    ViewData["Title"] = "Delete Destination";
}

<div class="form-page">

    <div class="horizons-container">

        <!-- Header -->
        <div class="form-header">

            <h1 class="section-title">
                Delete Destination
            </h1>

            <p class="section-subtitle">
                This action cannot be undone
            </p>

        </div>


        <!-- Delete card -->
        <div class="form-card form-delete-card">

            <!-- Warning icon -->
            <div class="delete-warning-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <!-- Destination name -->
            <h2 class="delete-destination-name">
                @Model.Name
            </h2>

            <!-- Destination meta -->
            <div class="delete-destination-meta">

                @if (!string.IsNullOrWhiteSpace(Model.Publisher))
                {
                    <div class="delete-meta-item">
                        <i class="fas fa-user"></i>
                        <span>
                            <strong>Published by:</strong> @Model.Publisher
                        </span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PublishedOn))
                {
                    <div class="delete-meta-item">
                        <i class="fas fa-calendar"></i>
                        <span>
                            <strong>Published on:</strong> @Model.PublishedOn
                        </span>
                    </div>
                }

            </div>

            <!-- Warning box -->
            <div class="form-danger-zone">

                <h3>
                  
                    Warning
                </h3>

                <p>
                    This action cannot be undone.
                </p>

                <p>
                    Are you sure you want to permanently delete
                    <strong>@Model.Name</strong>?
                </p>

            </div>

            <!-- Actions -->
            <div class="delete-actions">

                <form asp-action="DeleteConfirmed"
                      method="post"
                      class="delete-form">

                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt"></i>
                        Yes, Delete It
                    </button>

                </form>

                <a asp-controller="Destination"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-secondary">
                    <i class="fas fa-shield-alt"></i>
                    Cancel, Keep It
                </a>

            </div>

        </div>

    </div>

</div>