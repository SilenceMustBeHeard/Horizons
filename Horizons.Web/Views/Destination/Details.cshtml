@using Horizons.Web.ViewModels.Destination
@model DestinationDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="destination-details">

    <!-- Back -->
    <a asp-controller="Destination"
       asp-action="Index"
       class="back-link">
        <i class="fas fa-arrow-left"></i>
        Back to Explore
    </a>

    <!-- Hero -->
    <article class="destination-hero">

        <!-- Image -->
        <div class="destination-hero-image">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl)
                        ? "/images/default-image.jpg"
                        : Model.ImageUrl)"
                 alt="@Model.Name"
                 class="destination-image" />

            @if (User.Identity?.IsAuthenticated == true &&
                 !Model.IsUserPublisher)
            {
                <form asp-action="@(Model.IsUserFavourite
                                   ? "RemoveFromFavorites"
                                   : "AddToFavorites")"
                      method="post"
                      class="destination-hero-favorite">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn-favorite @(Model.IsUserFavourite ? "active" : "")"
                            aria-pressed="@(Model.IsUserFavourite ? "true" : "false")">

                        <i class="@(Model.IsUserFavourite
                                    ? "fas fa-heart"
                                    : "far fa-heart")"></i>

                    </button>

                </form>
            }
        </div>

        <!-- Hero Info -->
        <div class="destination-hero-info">

            <div class="destination-location">
                <i class="fas fa-map-marker-alt"></i>

                @(string.IsNullOrEmpty(Model.Country)
                    ? "Unknown Location"
                    : Model.Country)

                @if (!string.IsNullOrEmpty(Model.Continent))
                {
                    <span>•</span>
                    @Model.Continent
                }
            </div>

            <h1 class="destination-title">
                @Model.Name
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.TerrainName))
            {
                <div class="destination-terrain">
                    <i class="fas fa-mountain"></i>
                    @Model.TerrainName
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="destination-lead">
                    @Model.Description
                </p>
            }

            <!-- Quick meta -->
            <div class="destination-hero-meta">

                @if (!string.IsNullOrWhiteSpace(Model.PublisherName))
                {
                    <div class="hero-meta-item">
                        <i class="fas fa-user"></i>
                        <div>
                            <span class="hero-meta-label">Publisher</span>
                            <span class="hero-meta-value">@Model.PublisherName</span>
                        </div>
                    </div>
                }

                <div class="hero-meta-item">
                    <i class="fas fa-calendar"></i>
                    <div>
                        <span class="hero-meta-label">Published</span>
                        <span class="hero-meta-value">@Model.PublishedOn</span>
                    </div>
                </div>

                <div class="hero-meta-item">
                    <i class="fas fa-heart"></i>
                    <div>
                        <span class="hero-meta-label">Favorites</span>
                        <span class="hero-meta-value">@(Model.FavoriteCount ?? 0)</span>
                    </div>
                </div>

            </div>

            <!-- Actions -->
            <div class="destination-hero-actions">

                <a
                 asp-controller="Destination"
                   asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left"></i>
                    Back to Explore

                </a>

          @if (Model.IsUserPublisher)
{
    <a asp-controller="Destination"
       asp-action="Edit"
         asp-route-id="@Model.Id"
       class="btn btn-outline-primary">
        <i class="fas fa-edit"></i>
        Edit Story
    </a>

    <a asp-controller="Destination"
       asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-outline-danger">
        <i class="fas fa-trash"></i>
        Delete
    </a>
}

            </div>

        </div>

    </article>

    <!-- Content -->
    <div class="destination-content">

        <!-- Quick Facts -->
        <section class="destination-section">

            <h2 class="destination-section-title">
                Quick Facts
            </h2>

            <div class="destination-facts">

                @if (!string.IsNullOrWhiteSpace(Model.Continent))
                {
                    <div class="fact-item">
                        <i class="fas fa-globe-americas"></i>
                        <div>
                            <span class="fact-label">Continent</span>
                            <span class="fact-value">@Model.Continent</span>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Country))
                {
                    <div class="fact-item">
                        <i class="fas fa-flag"></i>
                        <div>
                            <span class="fact-label">Country</span>
                            <span class="fact-value">@Model.Country</span>
                        </div>
                    </div>
                }

                @if (Model.TravelDistance.HasValue)
                {
                    <div class="fact-item">
                        <i class="fas fa-road"></i>
                        <div>
                            <span class="fact-label">Travel Distance</span>
                            <span class="fact-value">@Model.TravelDistance.Value.ToString("N0") km</span>
                        </div>
                    </div>
                }

                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <div class="fact-item">
                        <i class="fas fa-crosshairs"></i>
                        <div>
                            <span class="fact-label">Coordinates</span>
                            <span class="fact-value">
                                @Model.Latitude.Value.ToString("0.0000")°,
                                @Model.Longitude.Value.ToString("0.0000")°
                            </span>
                        </div>
                    </div>
                }

                <div class="fact-item">
                    <i class="fas fa-calendar-alt"></i>
                    <div>
                        <span class="fact-label">Published</span>
                        <span class="fact-value">@Model.PublishedOn</span>
                    </div>
                </div>

            </div>

        </section>

        <!-- The Journey -->
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <section class="destination-section">

                <h2 class="destination-section-title">
                    The Journey
                </h2>

                <p class="destination-prose">
                    @Model.Description
                </p>

            </section>
        }

        <!-- Map -->
        <section class="destination-section">

            <h2 class="destination-section-title">
                Location
            </h2>

            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
            {
                <div class="destination-map"
                     id="destinationMap"
                     data-latitude="@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-longitude="@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-name="@Model.Name"
                     data-country="@Model.Country"
                     data-continent="@Model.Continent">
                </div>

                <div class="destination-map-coords">

                    <span class="coordinates">
                        <i class="fas fa-crosshairs"></i>
                        <span>@Model.Latitude.Value.ToString("0.0000")°</span>
                        <span>@Model.Longitude.Value.ToString("0.0000")°</span>
                    </span>

                </div>
            }
            else
            {
                <div class="destination-map">
                    <div class="map-placeholder">
                        <i class="fas fa-map-pin"></i>
                        <p>Location coordinates not available</p>
                        <small>Check back soon for updates</small>
                    </div>
                </div>
            }

        </section>

        <!-- Tags -->
        @if (!string.IsNullOrWhiteSpace(Model.TerrainName))
        {
            <div class="destination-tags">

                <span class="destination-tag">
                    <i class="fas fa-mountain"></i>
                    &nbsp;@Model.TerrainName
                </span>

            </div>
        }

        <!-- Author -->
        @if (!string.IsNullOrWhiteSpace(Model.PublisherName))
        {
            <div class="destination-author">

                <span class="destination-author-icon">
                    <i class="fas fa-user"></i>
                </span>

                <div>
                    <div class="destination-author-label">
                        Published by
                    </div>
                    <div class="destination-author-name">
                        @Model.PublisherName
                    </div>
                </div>

            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="~/js/destination-details.js" asp-append-version="true"></script>
}