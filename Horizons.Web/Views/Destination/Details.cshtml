@using Horizons.Web.ViewModels.Destination
@model DestinationDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<!-- Hero Section -->
<section class="detail-hero">
    <div class="detail-hero-image" style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.6)), url('@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-image.jpg" : Model.ImageUrl)')">
        <div class="container">
            <div class="detail-hero-content">
                <div class="detail-location">
                    <i class="fas fa-map-marker-alt"></i>
                    @(string.IsNullOrEmpty(Model.Country) ? "Unknown Location" : Model.Country)
                    @if (!string.IsNullOrEmpty(Model.Continent))
                    {
                        <span class="separator">•</span>
                        @Model.Continent
                    }
                </div>
                <h1 class="detail-title">@Model.Name</h1>
                <div class="detail-meta">
                    <span class="meta-item">
                        <i class="fas fa-user"></i> By @Model.PublisherName
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-calendar"></i> @Model.PublishedOn
                    </span>
                    <span class="meta-item">
                        <i class="fas fa-heart"></i> @(Model.FavoriteCount ?? 0) travelers love this
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container detail-container">
    <div class="row g-5">
        <!-- Main Content -->
        <div class="col-lg-7">
            <!-- Terrain Badge -->
            <div class="terrain-badge mb-4">
                <span class="badge-terrain">
                    <i class="fas fa-mountain"></i> @Model.TerrainName
                </span>
            </div>

            <!-- Story Section -->
            <div class="detail-section">
                <h2 class="detail-section-title">The Journey</h2>
                <div class="detail-story">
                    <p>@Model.Description</p>
                </div>
            </div>

            <!-- Fun Facts Section -->
            <div class="detail-section">
                <h2 class="detail-section-title">Quick Facts</h2>
                <div class="facts-grid">
                    @if (!string.IsNullOrEmpty(Model.Continent))
                    {
                        <div class="fact-item">
                            <i class="fas fa-globe-americas"></i>
                            <div class="fact-content">
                                <strong>Continent</strong>
                                <span>@Model.Continent</span>
                            </div>
                        </div>
                    }
                    @if (Model.TravelDistance.HasValue)
                    {
                        <div class="fact-item">
                            <i class="fas fa-road"></i>
                            <div class="fact-content">
                                <strong>Travel Distance</strong>
                                <span>@Model.TravelDistance.Value.ToString("N0") km</span>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Country))
                    {
                        <div class="fact-item">
                            <i class="fas fa-flag"></i>
                            <div class="fact-content">
                                <strong>Country</strong>
                                <span>@Model.Country</span>
                            </div>
                        </div>
                    }
                    <div class="fact-item">
                        <i class="fas fa-calendar-alt"></i>
                        <div class="fact-content">
                            <strong>Published</strong>
                            <span>@Model.PublishedOn</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PublisherName))
                    {
                        <div class="fact-item">
                            <i class="fas fa-user"></i>
                            <div class="fact-content">
                                <strong>Publisher</strong>
                                <span>@Model.PublisherName</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-5">
            <!-- Map Card -->
            <div class="sidebar-card">
                <h3 class="sidebar-card-title">
                    <i class="fas fa-map-marked-alt"></i> Location
                </h3>

                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <div class="map-preview">
                        <div class="map-placeholder">
                            <i class="fas fa-map-marker-alt"></i>
                            <div class="coordinates">
                                <span class="coord">@Model.Latitude.Value.ToString("0.0000")°</span>
                                <span class="coord">@Model.Longitude.Value.ToString("0.0000")°</span>
                            </div>
                        </div>
                        <div class="map-actions">
                            <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude"
                               target="_blank"
                               class="btn-map">
                                <i class="fas fa-directions"></i> Get Directions
                            </a>
                            <a href="https://www.google.com/maps/place/@Model.Latitude,@Model.Longitude"
                               target="_blank"
                               class="btn-map btn-map-outline">
                                <i class="fas fa-external-link-alt"></i> Open in Maps
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="map-placeholder no-coordinates">
                        <i class="fas fa-map-pin"></i>
                        <p>Location coordinates not available</p>
                        <small>Check back soon for updates</small>
                    </div>
                }
            </div>

            <!-- Stats Card -->
            <div class="sidebar-card">
                <h3 class="sidebar-card-title">
                    <i class="fas fa-chart-line"></i> Engagement
                </h3>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-number">@(Model.FavoriteCount ?? 0)</span>
                        <span class="stat-label">Travelers ❤️ this</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="sidebar-card action-card">
                <div class="action-buttons d-flex flex-column gap-2">
                    <a asp-controller="Destination" asp-action="Index" class="btn btn-secondary w-100">
                        <i class="fas fa-arrow-left"></i> Back to Explore
                    </a>

                    @if (User.Identity.IsAuthenticated && !Model.IsUserPublisher)
                    {
                        <form asp-action="@(Model.IsUserFavourite ? "RemoveFromFavorites" : "AddToFavorites")" method="post" class="w-100">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn @(Model.IsUserFavourite ? "btn-danger" : "btn-primary") w-100">
                                @if (Model.IsUserFavourite)
                                {
                                    <text><i class="fas fa-heart-broken"></i> Remove from Favorites</text>
                                }
                                else
                                {
                                    <text><i class="fas fa-heart"></i> Add to Favorites</text>
                                }
                            </button>
                        </form>
                    }

                    @if (Model.IsUserPublisher)
                    {
                        <div class="admin-buttons d-flex flex-column gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline w-100">
                                <i class="fas fa-edit"></i> Edit Story
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger w-100">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>