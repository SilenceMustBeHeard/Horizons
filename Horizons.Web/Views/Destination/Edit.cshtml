@using Horizons.Web.ViewModels.Destination
@model DestinationEditInputModel

@{
    ViewData["Title"] = "Edit Destination";
}

<div class="form-page">

    <div class="horizons-container">

        <!-- Header -->
        <div class="form-header">

            <span class="section-tag">UPDATE YOUR STORY</span>

            <h1 class="section-title">
                Edit Destination
            </h1>

            <p class="section-subtitle">
                Update your adventure story and keep your journey fresh
            </p>

        </div>


        <!-- Form -->
        <div class="form-card form-card-wide">

            <form asp-action="Edit" method="post" class="horizons-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="form-validation-summary">
                </div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="PublishedOn" />


                <!-- basic information -->
                <section class="form-section">

                    <h3 class="form-section-title">
                        <i class="fas fa-info-circle"></i>
                        Basic Information
                    </h3>

                    <div class="form-row">

                        <div class="form-group">
                            <label asp-for="Name" class="form-label">
                                Destination Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="e.g., Everest Base Camp" />

                            <span asp-validation-for="Name"
                                  class="form-error">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TerrainId" class="form-label">
                                Terrain Type
                            </label>

                            <select asp-for="TerrainId"
                                    class="form-control"
                                    asp-items="@(new SelectList(Model.Terrains, "Id", "Name"))">

                                <option value="">Select terrain</option>
                            </select>

                            <span asp-validation-for="TerrainId"
                                  class="form-error">
                            </span>
                        </div>

                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="form-label">
                            Adventure Story
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe your incredible journey..."></textarea>

                        <span asp-validation-for="Description"
                              class="form-error">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ImageUrl" class="form-label">
                            Image URL
                        </label>

                        <input asp-for="ImageUrl"
                               id="ImageUrl"
                               class="form-control"
                               placeholder="https://..." />

                        <span asp-validation-for="ImageUrl"
                              class="form-error">
                        </span>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="form-image-preview">

                                <img id="imagePreview"
                                     src="@Model.ImageUrl"
                                     alt="Preview"
                                     class="image-preview"
                                     onerror="this.src='/images/default-image.jpg'" />

                                <span class="form-image-preview-label">
                                    Current image preview
                                </span>

                            </div>
                        }
                    </div>

                </section>


                <!-- map location -->
                <section class="form-section">

                    <h3 class="form-section-title">
                        <i class="fas fa-map-marked-alt"></i>
                        Map Location
                    </h3>

                    <div class="form-row">

                        <div class="form-group">
                            <label asp-for="Country" class="form-label">
                                Country
                            </label>

                            <input asp-for="Country"
                                   class="form-control"
                                   placeholder="e.g., Nepal" />

                            <span asp-validation-for="Country"
                                  class="form-error">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Continent" class="form-label">
                                Continent
                            </label>

                            <select asp-for="Continent" class="form-control">

                                <option value="">Select continent</option>
                                <option value="Asia">🌏 Asia</option>
                                <option value="Europe">🇪🇺 Europe</option>
                                <option value="North America">🌎 North America</option>
                                <option value="South America">🌎 South America</option>
                                <option value="Africa">🦁 Africa</option>
                                <option value="Oceania">🏝️ Oceania</option>
                                <option value="Antarctica">❄️ Antarctica</option>

                            </select>

                            <span asp-validation-for="Continent"
                                  class="form-error">
                            </span>
                        </div>

                    </div>

                    <div class="form-row form-row-3">

                        <div class="form-group">
                            <label asp-for="Latitude" class="form-label">
                                Latitude
                            </label>

                            <input asp-for="Latitude"
                                   id="Latitude"
                                   class="form-control"
                                   placeholder="27.9881"
                                   step="any" />

                            <small class="form-hint">
                                Range: -90 to 90 (negative for South)
                            </small>

                            <span asp-validation-for="Latitude"
                                  class="form-error">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Longitude" class="form-label">
                                Longitude
                            </label>

                            <input asp-for="Longitude"
                                   id="Longitude"
                                   class="form-control"
                                   placeholder="86.9250"
                                   step="any" />

                            <small class="form-hint">
                                Range: -180 to 180 (negative for West)
                            </small>

                            <span asp-validation-for="Longitude"
                                  class="form-error">
                            </span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TravelDistance" class="form-label">
                                Distance (km)
                            </label>

                            <input asp-for="TravelDistance"
                                   class="form-control"
                                   placeholder="150"
                                   step="any" />

                            <small class="form-hint">
                                Optional
                            </small>

                            <span asp-validation-for="TravelDistance"
                                  class="form-error">
                            </span>
                        </div>

                    </div>

                </section>


                <!--actions -->
                <div class="form-actions">

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i>
                        Save Changes
                    </button>

                    <a asp-controller="Destination"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-secondary">
                        <i class="fas fa-times"></i>
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/destination-edit.js" asp-append-version="true"></script>
}