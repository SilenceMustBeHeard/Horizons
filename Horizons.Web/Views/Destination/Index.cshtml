@using Horizons.Web.ViewModels.Destination
@model IEnumerable<DestinationIndexViewModel>

@{
    ViewData["Title"] = "Explore Destinations - Horizons";
}

<!-- Hero -->
<section class="welcome-section">
    <div class="horizons-container">

        <span class="section-tag">EXPLORE THE WORLD</span>

        <h1 class="hero-title">
            With Horizons
        </h1>

        <p class="hero-description">
            Discover amazing destinations, conquer new challenges,
            and start your adventure today.
        </p>

        <a asp-controller="Destination"
           asp-action="Map"
           class="btn btn-primary btn-lg">
            <i class="fas fa-map-marked-alt"></i>
            View on Map
        </a>

    </div>
</section>


<!-- Featured Destinations -->
<section class="explore-section">
    <div class="horizons-container">

        <div class="section-header text-center">
            <span class="section-tag">CURATED COLLECTION</span>
            <h2 class="section-title">Featured Destinations</h2>
            <p class="section-subtitle">
                Hand-picked adventures from our community
            </p>
        </div>

        @if (Model.Any())
        {
            <div class="destinations-grid">

                @foreach (var dest in Model)
                {
                    <article class="card hover-scale">

                        <img src="@(string.IsNullOrEmpty(dest.ImageUrl)
                                    ? "/images/default-image.jpg"
                                    : dest.ImageUrl)"
                             class="card-img-top"
                             alt="@dest.Name"
                             loading="lazy"
                             onerror="this.src='/images/default-image.jpg'" />

                        <div class="card-body">

                            <h3 class="card-title">
                                @dest.Name
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(dest.TerrainName))
                            {
                                <p class="card-text">
                                    <i class="fas fa-mountain"></i>
                                    @dest.TerrainName
                                </p>
                            }

                            <div class="card-actions">

                                <a asp-action="Details"
                                   asp-route-id="@dest.Id"
                                   class="btn btn-primary">
                                    <i class="fas fa-eye"></i>
                                    Explore
                                </a>

                                @if (User.Identity?.IsAuthenticated == true &&
                                     !dest.IsUserPublisher)
                                {
                                    <form asp-action="@(dest.IsUserFavourite
                                                       ? "RemoveFromFavorites"
                                                       : "AddToFavorites")"
                                          method="post"
                                          class="card-favorite-form">

                                        <input type="hidden"
                                               name="id"
                                               value="@dest.Id" />

                                        <button type="submit"
                                                class="btn-heart @(dest.IsUserFavourite
                                                                  ? "btn-danger active-heart"
                                                                  : "btn-warning")"
                                                aria-label="@(dest.IsUserFavourite
                                                             ? "Remove from favorites"
                                                             : "Add to favorites")">

                                            <i class="@(dest.IsUserFavourite
                                                        ? "fas fa-heart-broken"
                                                        : "fas fa-heart")"></i>

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    <i class="fas fa-compass"></i>
                </div>

                <h3>No destinations yet</h3>
                <p>Be the first to share your journey with the community.</p>

                <a asp-controller="Destination"
                   asp-action="Add"
                   class="btn btn-primary">
                    <i class="fas fa-plus-circle"></i>
                    Share Your Story
                </a>

            </div>
        }

    </div>
</section>