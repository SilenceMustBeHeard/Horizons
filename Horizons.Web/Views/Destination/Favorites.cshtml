@using Horizons.Web.ViewModels.Destination
@model IEnumerable<DestinationFavoriteViewModel>

@{
    ViewData["Title"] = "My Favorites";
}

<section class="favorites-page">

    <div class="horizons-container">

        <!-- Header -->
        <div class="section-header text-center">

            <span class="section-tag">YOUR COLLECTION</span>

            <h1 class="section-title">
                My Favorite Destinations
            </h1>

            <p class="section-subtitle">
                Your ultimate adventure bucket list
            </p>

        </div>


        @if (Model == null || !Model.Any())
        {
            <!-- Empty state -->
            <div class="empty-state">

                <div class="empty-state-icon">
                    <i class="fas fa-heart-broken"></i>
                </div>

                <h3>No favorites yet</h3>

                <p>
                    Start exploring and add destinations to your favorites.
                </p>

                <a asp-controller="Destination"
                   asp-action="Index"
                   class="btn btn-primary">
                    <i class="fas fa-compass"></i>
                    Explore Destinations
                </a>

            </div>
        }
        else
        {
            <!-- Favorites list -->
            <div class="favorites-list">

                @foreach (var destination in Model)
                {
                    <article class="favorite-item">

                        <!-- Image -->
                        <div class="favorite-item-image">
                            <img src="@(string.IsNullOrEmpty(destination.ImageUrl)
                                        ? "/images/default-image.jpg"
                                        : destination.ImageUrl)"
                                 alt="@destination.Name"
                                 loading="lazy"
                                 onerror="this.src='/images/default-image.jpg'" />
                        </div>

                        <!-- Info -->
                        <div class="favorite-item-info">

                            <h3 class="favorite-item-title">
                                <a asp-controller="Destination"
                                   asp-action="Details"
                                   asp-route-id="@destination.Id">
                                    @destination.Name
                                </a>
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(destination.Terrain))
                            {
                                <p class="favorite-item-terrain">
                                    <i class="fas fa-mountain"></i>
                                    @destination.Terrain
                                </p>
                            }

                        </div>

                        <!-- Actions -->
                        <div class="favorite-item-actions">

                            <a asp-controller="Destination"
                               asp-action="Details"
                               asp-route-id="@destination.Id"
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye"></i>
                                View
                            </a>

                            <form asp-controller="Destination"
                                  asp-action="RemoveFromFavorites"
                                  asp-route-id="@destination.Id"
                                  method="post"
                                  class="favorite-remove-form">

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash-alt"></i>
                                    Remove
                                </button>

                            </form>

                        </div>

                    </article>
                }

            </div>

            <!-- Footer actions -->
            <div class="favorites-footer">

                <a asp-controller="Destination"
                   asp-action="Index"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back to Destinations
                </a>

            </div>
        }

    </div>

</section>