@using Horizons.Web.ViewModels.Map
@model IEnumerable<MapDestinationDto>
@{
    ViewData["Title"] = "Travel Map - Horizons";
}

<div class="map-page">

    <!-- Header -->
    <div class="map-header">
        <span class="map-header-label">
            <i class="fas fa-map-marked-alt"></i>
            Explore
        </span>

        <h1>Explore the World</h1>

        <p>Every pin tells a story. Every route is an adventure.</p>
    </div>

    <!-- Map with sidebar -->
    <div class="map-layout">

        <!-- Sidebar -->
        <aside class="map-sidebar">

            <h2 class="map-sidebar-title">
                Destinations
            </h2>

            <!-- Search -->
            <div class="map-search">
                <div class="map-search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           id="searchDestinations"
                           placeholder="Search destinations..." />
                </div>
            </div>

            <!-- Filters -->
            <div class="map-legend">
                <div class="map-legend-title">Filter</div>

                <div class="filter-tags">
                    <button class="filter-tag active" data-filter="all">All</button>
                    <button class="filter-tag" data-filter="asia">🌏 Asia</button>
                    <button class="filter-tag" data-filter="europe">🇪🇺 Europe</button>
                    <button class="filter-tag" data-filter="north america">🌎 North America</button>
                    <button class="filter-tag" data-filter="south america">🌎 South America</button>
                    <button class="filter-tag" data-filter="africa">🦁 Africa</button>
                    <button class="filter-tag" data-filter="oceania">🏝️ Oceania</button>
                    <button class="filter-tag" data-filter="antarctica">❄️ Antarctica</button>
                </div>
            </div>

            <!-- Stats -->
            <div class="map-legend">
                <div class="map-legend-title">Stats</div>

                <div class="map-legend-item">
                    <span class="map-legend-marker"></span>
                    <span>
                        <strong id="destinationCount">0</strong> Destinations
                    </span>
                </div>

                <div class="map-legend-item">
                    <span class="map-legend-marker accent"></span>
                    <span>
                        <strong id="countriesCount">0</strong> Countries
                    </span>
                </div>

                <div class="map-legend-item">
                    <span class="map-legend-marker info"></span>
                    <span>
                        <strong id="totalDistance">0</strong> KM Traveled
                    </span>
                </div>
            </div>

            <!-- Destinations list -->
            <div class="destinations-list" id="destinationsList">
                <div class="map-loading-content">
                    <div class="map-loading-spinner"></div>
                    <span>Loading destinations...</span>
                </div>
            </div>

        </aside>

        <!-- Map -->
        <div class="map-wrapper"
             style="margin: 0; border: 0; border-radius: 0; box-shadow: none; width: 100%;">

            <div id="map" class="map-container"></div>

            <div class="map-status">
                <span class="map-status-dot"></span>
                <span>Interactive map</span>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/map.js" asp-append-version="true"></script>
}