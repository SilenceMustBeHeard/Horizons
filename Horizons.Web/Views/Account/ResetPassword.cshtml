﻿@using Horizons.Web.ViewModels.Account.Profile
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Create New Password - Horizons";
}

<div class="auth-wrapper">
    <div class="auth-card" style="max-width: 480px;">
        <div class="auth-icon">
            <i class="fas fa-lock"></i>
        </div>

        <h1 class="auth-title">Create New Password</h1>
        <p class="auth-subtitle">Choose a strong password for your account</p>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="error-message" style="color: #dc3545; font-size: 0.85rem; margin-bottom: 1rem;"></div>

            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label asp-for="Password" class="form-label">New Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Create a new password" />
                <span asp-validation-for="Password" class="error-message"></span>
                <div class="password-hint" style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.25rem;">
                    Minimum 6 characters
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your new password" />
                <span asp-validation-for="ConfirmPassword" class="error-message"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="width: 100%;">
                <i class="fas fa-save"></i> Reset Password
            </button>

            <div class="auth-footer" style="margin-top: 1.5rem;">
                <a asp-action="Login" class="auth-link">
                    <i class="fas fa-arrow-left"></i> Back to Sign In
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}