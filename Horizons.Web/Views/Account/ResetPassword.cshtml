@using Horizons.Web.ViewModels.Account.Profile
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password - Horizons";
}

<div class="fullscreen-auth">
    <div class="auth-background">
        <div class="stars"></div>
        <div class="twinkling"></div>
    </div>

    <div class="auth-container">
        <div class="auth-card" style="max-width: 450px;">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-lock"></i>
                    <i class="fas fa-redo-alt"></i>
                </div>
                <h1 class="auth-title">CREATE NEW PASSWORD</h1>
                <div class="auth-divider"></div>
                <p class="auth-subtitle">Enter your new password below</p>
            </div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="form-group">
                    <label asp-for="Password" class="form-label">
                        <i class="fas fa-lock"></i> New Password
                    </label>
                    <input asp-for="Password" type="password" class="form-control auth-input" placeholder="Min 6 characters" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="fas fa-check-circle"></i> Confirm Password
                    </label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control auth-input" placeholder="Confirm your password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-auth btn-primary w-100">
                    <i class="fas fa-save"></i>
                    <span>RESET PASSWORD</span>
                </button>

                <div class="auth-footer mt-4">
                    <a asp-action="Login" class="auth-link">
                        <i class="fas fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>