@using Horizons.Web.ViewModels.Account.Profile
@model LoginViewModel

@{
    ViewData["Title"] = "Sign In - Horizons";
}

<div class="auth-page">

 <div class="auth-container">

    <div class="auth-card">

        <div class="auth-icon">
            <i class="fas fa-map-marked-alt"></i>
        </div>

        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to continue your journey</p>

        <form asp-action="Login" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="hello@horizons.com"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="••••••••"
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <div class="form-options">
                <label class="checkbox-label">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span class="checkbox-text">Remember me</span>
                </label>

                <a asp-action="ForgotPassword" class="forgot-link">
                    Forgot password?
                </a>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <i class="fas fa-sign-in-alt"></i>
                <span>Sign In</span>
            </button>

            <div class="auth-footer">
                <span class="footer-text">Don't have an account?</span>
                <a asp-action="Register" class="auth-link">Join Horizons</a>
            </div>

        </form>

    </div>

    </div>


</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}