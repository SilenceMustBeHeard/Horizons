@using Horizons.Web.ViewModels.Account.Profile
@model RegisterViewModel

@{
    ViewData["Title"] = "Join Horizons";
}

<div class="auth-page">
<div class="auth-container">
    <div class="auth-card auth-card-wide">

        <div class="auth-icon">
            <i class="fas fa-compass"></i>
        </div>

        <h1 class="auth-title">Start Your Journey</h1>
        <p class="auth-subtitle">Join a community of adventurers exploring the world</p>

        <form asp-action="Register" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Alex" />
                    <span asp-validation-for="FirstName" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" placeholder="Johnson" />
                    <span asp-validation-for="LastName" class="field-validation"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="hello@horizons.com" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="AlternateEmail" class="form-label">
                    Alternate Email
                    <span class="label-optional">(Optional)</span>
                </label>
                <input asp-for="AlternateEmail" class="form-control" placeholder="backup@example.com" />
                <span asp-validation-for="AlternateEmail" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address" class="form-label">
                    Location
                    <span class="label-optional">(Optional)</span>
                </label>
                <input asp-for="Address" class="form-control" placeholder="City, Country" />
                <span asp-validation-for="Address" class="field-validation"></span>
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Create a password" />
                    <span asp-validation-for="Password" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm your password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
                </div>

            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <i class="fas fa-flag-checkered"></i>
                <span>Create Account</span>
            </button>

            <div class="auth-footer">
                <span class="footer-text">Already have an account?</span>
                <a asp-action="Login" class="auth-link">Sign In</a>
            </div>

        </form>

    </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}