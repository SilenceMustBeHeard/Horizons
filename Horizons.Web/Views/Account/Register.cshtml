﻿@using Horizons.Web.ViewModels.Account.Profile
@model RegisterViewModel
@{
    ViewData["Title"] = "Register - Horizons";
}

<div class="fullscreen-auth">
    <div class="auth-background">
        <div class="stars"></div>
        <div class="twinkling"></div>
        <div class="mountains-bg"></div>
    </div>

    <div class="auth-container">
        <div class="auth-card register-card">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-flag-checkered"></i>
                    <i class="fas fa-mountain"></i>
                </div>
                <h1 class="auth-title">START YOUR JOURNEY</h1>
                <div class="auth-divider"></div>
                <p class="auth-subtitle">Join the Horizons adventure community</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-row">
                    <div class="form-group half">
                        <label asp-for="FirstName" class="form-label">
                            <i class="fas fa-user"></i> First Name
                        </label>
                        <input asp-for="FirstName" class="form-control auth-input" placeholder="John" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="form-group half">
                        <label asp-for="LastName" class="form-label">
                            <i class="fas fa-user"></i> Last Name
                        </label>
                        <input asp-for="LastName" class="form-control auth-input" placeholder="Doe" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <input asp-for="Email" class="form-control auth-input" placeholder="adventurer@horizons.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AlternateEmail" class="form-label">
                        <i class="fas fa-envelope-open"></i> Alternate Email (Optional)
                    </label>
                    <input asp-for="AlternateEmail" class="form-control auth-input" placeholder="backup@horizons.com" />
                    <span asp-validation-for="AlternateEmail" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address" class="form-label">
                        <i class="fas fa-location-dot"></i> Address (Optional)
                    </label>
                    <input asp-for="Address" class="form-control auth-input" placeholder="Your basecamp location" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="form-row">
                    <div class="form-group half">
                        <label asp-for="Password" class="form-label">
                            <i class="fas fa-lock"></i> Password
                        </label>
                        <input asp-for="Password" type="password" class="form-control auth-input" placeholder="Min 6 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-group half">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="fas fa-check-circle"></i> Confirm Password
                        </label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control auth-input" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn-auth btn-primary">
                    <i class="fas fa-flag-checkered"></i>
                    <span>CREATE ACCOUNT</span>
                </button>

                <div class="auth-footer">
                    <span class="footer-text">Already have an account?</span>
                    <a asp-action="Login" class="auth-link">LOGIN NOW</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}