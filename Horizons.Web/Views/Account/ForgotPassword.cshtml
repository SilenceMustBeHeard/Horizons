@using Horizons.Web.ViewModels.Account.Profile
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password - Horizons";
}

<div class="fullscreen-auth">
    <div class="auth-background">
        <div class="stars"></div>
        <div class="twinkling"></div>
    </div>

    <div class="auth-container">
        <div class="auth-card" style="max-width: 450px;">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-key"></i>
                    <i class="fas fa-question-circle"></i>
                </div>
                <h1 class="auth-title">FORGOT PASSWORD</h1>
                <div class="auth-divider"></div>
                <p class="auth-subtitle">Enter your email to reset your password</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <input asp-for="Email" class="form-control auth-input" placeholder="adventurer@horizons.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-auth btn-primary w-100">
                    <i class="fas fa-paper-plane"></i>
                    <span>SEND RESET LINK</span>
                </button>

                <div class="auth-footer mt-4">
                    <a asp-action="Login" class="auth-link">
                        <i class="fas fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>