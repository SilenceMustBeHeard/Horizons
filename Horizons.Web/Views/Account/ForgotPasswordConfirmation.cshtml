﻿@{
ViewData["Title"] = "Check Your Inbox - Horizons";
}

<div class="auth-wrapper">
    <div class="auth-card" style="max-width: 480px; text-align: center;">
        <div class="auth-icon">
            <i class="fas fa-envelope-open-text"></i>
        </div>

        <h1 class="auth-title">Check Your Inbox</h1>

        <div class="confirmation-icon" style="margin: 2rem 0;">
            <i class="fas fa-paper-plane" style="font-size: 4rem; color: var(--accent-primary); opacity: 0.8;"></i>
        </div>

        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
            We've sent a password reset link to your email address.
        </p>

        <div class="info-box" style="background: #f5f0e8; border-radius: 12px; padding: 1rem; margin: 1.5rem 0; text-align: left;">
            <i class="fas fa-clock" style="color: var(--accent-primary); margin-right: 0.5rem;"></i>
            <span style="font-size: 0.85rem; color: var(--text-secondary);">The link will expire in 24 hours for security reasons.</span>
        </div>

        <div class="auth-footer" style="margin-top: 1.5rem;">
            <a asp-action="Login" class="auth-link">
                <i class="fas fa-sign-in-alt"></i> Return to Sign In
            </a>
        </div>
    </div>
</div>