@{
    ViewData["Title"] = "Reset Link Sent - Horizons";
}

<div class="fullscreen-auth">
    <div class="auth-background">
        <div class="stars"></div>
        <div class="twinkling"></div>
    </div>

    <div class="auth-container">
        <div class="auth-card" style="max-width: 450px; text-align: center;">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
                <h1 class="auth-title">CHECK YOUR INBOX</h1>
                <div class="auth-divider"></div>
            </div>

            <div style="margin: 30px 0;">
                <i class="fas fa-paper-plane" style="font-size: 60px; color: var(--sport-primary);"></i>
            </div>

            <p class="error-message" style="margin-bottom: 20px;">
                We've sent a password reset link to your email address.
            </p>

            <div class="alert-box" style="background: rgba(0,212,255,0.1); border-left: 3px solid #00D4FF; padding: 15px; border-radius: 8px; margin: 20px 0; text-align: left;">
                <i class="fas fa-clock" style="color: #00D4FF; margin-right: 10px;"></i>
                The link will expire in 24 hours for security reasons.
            </div>

            <div class="auth-footer mt-4">
                <a asp-action="Login" class="auth-link">
                    <i class="fas fa-sign-in-alt"></i> Return to Login
                </a>
            </div>
        </div>
    </div>
</div>