﻿@{
    ViewData["Title"] = "Password Reset - Horizons";
}

<div class="auth-page">

    <div class="auth-container">

        <div class="auth-card auth-card-center">

            <div class="auth-icon auth-icon-success">
                <i class="fas fa-check-circle"></i>
            </div>

            <h1 class="auth-title">Password Reset!</h1>

            <div class="auth-confirmation-icon">
                <i class="fas fa-flag-checkered"></i>
            </div>

            <p class="auth-message">
                Your password has been successfully reset.
                You can now sign in with your new password.
            </p>

            <div class="auth-footer">
                <a asp-action="Login" class="auth-link">
                    <i class="fas fa-sign-in-alt"></i>
                    Sign In Now
                </a>
            </div>

        </div>

    </div>

</div>