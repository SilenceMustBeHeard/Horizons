@{
    ViewData["Title"] = "Password Reset - Horizons";
}

<div class="fullscreen-auth">
    <div class="auth-background">
        <div class="stars"></div>
        <div class="twinkling"></div>
    </div>

    <div class="auth-container">
        <div class="auth-card" style="max-width: 450px; text-align: center;">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h1 class="auth-title">PASSWORD RESET!</h1>
                <div class="auth-divider"></div>
            </div>

            <div style="margin: 30px 0;">
                <i class="fas fa-flag-checkered" style="font-size: 60px; color: var(--sport-primary);"></i>
            </div>

            <p class="error-message" style="margin-bottom: 20px;">
                Your password has been successfully reset!
            </p>

            <div class="action-buttons" style="display: flex; justify-content: center; margin-top: 20px;">
                <a asp-action="Login" class="btn-adventure btn-primary" style="text-decoration: none;">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>LOGIN NOW</span>
                </a>
            </div>
        </div>
    </div>
</div>