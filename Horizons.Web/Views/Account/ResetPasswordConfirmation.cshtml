﻿@{
ViewData["Title"] = "Password Reset - Horizons";
}

<div class="auth-wrapper">
    <div class="auth-card" style="max-width: 480px; text-align: center;">
        <div class="auth-icon">
            <i class="fas fa-check-circle"></i>
        </div>

        <h1 class="auth-title">Password Reset!</h1>

        <div class="confirmation-icon" style="margin: 2rem 0;">
            <i class="fas fa-flag-checkered" style="font-size: 4rem; color: var(--accent-primary); opacity: 0.8;"></i>
        </div>

        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
            Your password has been successfully reset. You can now sign in with your new password.
        </p>

        <div class="action-buttons" style="display: flex; justify-content: center; margin-top: 1rem;">
            <a asp-action="Login" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-sign-in-alt"></i> Sign In Now
            </a>
        </div>
    </div>
</div>